# ==============================================================================
# TARANG Platform - Environment Configuration Template
# Notice: Copy this file to .env before starting the platform.
# All values here are development placeholders - no real secrets.
# ==============================================================================

# Database Configuration (PostgreSQL 14+ / PostGIS 3.2+)
POSTGRES_DB=tarang_db
POSTGRES_USER=tarang_user
POSTGRES_PASSWORD=tarang_insecure_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tarang_user:tarang_insecure_dev_password@postgres:5432/tarang_db

# Redis Configuration (Celery Broker, Cache, Rate Limits)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Authentication & Identity (Spring Boot Backend)
AUTH_SERVICE_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin_dev_password

# Asymmetric JWT Configuration (RS256 with Key ID)
JWT_KEY_ID=tarang-dev-key-v1
JWT_ALGORITHM=RS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30
# In production, load actual PEM files via volume mounts
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAzTarangDevKeyExample==\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAzTarangDevKeyExample==\n-----END RSA PRIVATE KEY-----"

# Application Backend (FastAPI Core & Pipeline)
APP_SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTH_SERVICE_URL=http://backend-auth:8080

# Storage Service Configuration
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=1024
ALLOWED_SONAR_EXTENSIONS=.xtf,.jsf,.hsx,.sdf,.png,.json

# Frontend Configuration (React + Vite)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost

# Nginx Gateway & CORS
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80,https://localhost
